DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace_with_at_least_32_characters_random_string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to "false" to turn off rate limiter in development; default enabled only in production/tests
ENABLE_RATE_LIMITER="false"

# Optional Email Dispatch via Resend (https://resend.com)
# When omitted, verification codes are logged directly to your terminal console
RESEND_API_KEY=""
# Defaults to "onboarding@resend.dev" for free tier testing without domain verification
EMAIL_FROM="onboarding@resend.dev"
